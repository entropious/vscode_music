{
  "name": "vscode-yandex-music",
  "displayName": "Yandex Music Player",
  "description": "Listen to Yandex Music in VS Code: My Vibe, Liked, playlists and search.",
  "version": "0.12.3",
  "publisher": "entro",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "homepage": "https://github.com/entropious/vscode_music#readme",
  "bugs": {
    "url": "https://github.com/entropious/vscode_music/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entropious/vscode_music"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "music",
    "yandex",
    "yandex music",
    "player",
    "music player"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yandexMusic",
          "title": "Yandex Music",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "yandexMusic": [
        {
          "type": "webview",
          "id": "yandexMusic.player",
          "name": "Player"
        }
      ]
    },
    "commands": [
      {
        "command": "yandexMusic.signIn",
        "title": "Sign In",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.setToken",
        "title": "Enter OAuth Token Manually",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.signOut",
        "title": "Sign Out",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.playPause",
        "title": "Play / Pause",
        "category": "Yandex Music",
        "icon": "$(debug-pause)"
      },
      {
        "command": "yandexMusic.next",
        "title": "Next Track",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.previous",
        "title": "Previous Track",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.like",
        "title": "Like / Unlike",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.dislike",
        "title": "Dislike / Remove Dislike",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.trackRadio",
        "title": "Start Radio from Current Track",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.search",
        "title": "Search and Play a Track",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.playMyWave",
        "title": "Play My Vibe",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.playLiked",
        "title": "Play Liked",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.playPlaylist",
        "title": "Play a Playlist…",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.openRemote",
        "title": "Open Fullscreen Remote",
        "category": "Yandex Music",
        "icon": "$(screen-full)"
      },
      {
        "command": "yandexMusic.installRemote",
        "title": "Install Fullscreen Remote",
        "category": "Yandex Music"
      },
      {
        "command": "yandexMusic.setGeniusToken",
        "title": "Set Genius Token for Music Videos",
        "category": "Yandex Music"
      }
    ],
    "keybindings": [
      {
        "command": "yandexMusic.playPause",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "yandexMusic.next",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right"
      },
      {
        "command": "yandexMusic.previous",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left"
      }
    ],
    "configuration": {
      "title": "Yandex Music",
      "properties": {
        "yandexMusic.quality": {
          "type": "string",
          "enum": [
            "high",
            "low"
          ],
          "default": "high",
          "description": "Stream quality: high picks the highest MP3 bitrate available, low the lowest."
        },
        "yandexMusic.volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "Default volume, from 0 to 1."
        },
        "yandexMusic.aiLabels": {
          "type": "boolean",
          "default": true,
          "description": "Mark AI-generated tracks: Yandex Music's own labels (\"AI use\" in the track's credits), and Deezer's detections unless yandexMusic.deezerAiLabels is off."
        },
        "yandexMusic.deezerAiLabels": {
          "type": "boolean",
          "default": true,
          "description": "Also mark tracks that Deezer's AI detector flagged, for tracks Yandex Music hasn't labeled. Uses a snapshot from May 2026 that the Slopless project mapped to Yandex Music; it's downloaded once from GitHub (5.5 MB)."
        },
        "yandexMusic.remote.motionCovers": {
          "type": "boolean",
          "default": true,
          "description": "Fullscreen remote: show Apple Music's motion cover of the album when the track has no video. The album is looked up on the iTunes Search API and music.apple.com."
        },
        "yandexMusic.remote.musicVideos": {
          "type": "boolean",
          "default": true,
          "description": "Fullscreen remote: show the track's music video, silent, behind the player: a 30-second preview from the iTunes Search API, or the YouTube video that Wikidata or, with a token set by Set Genius Token for Music Videos, Genius links."
        },
        "yandexMusic.remote.detailedGenres": {
          "type": "boolean",
          "default": true,
          "description": "Fullscreen remote: show finer genres from MusicBrainz, looked up by the track's artist and title."
        },
        "yandexMusic.apiBaseUrl": {
          "type": "string",
          "default": "https://api.music.yandex.net",
          "description": "Yandex Music API endpoint. Change it only for debugging."
        },
        "yandexMusic.oauthBaseUrl": {
          "type": "string",
          "default": "https://oauth.yandex.ru",
          "description": "Yandex OAuth server endpoint. Change it only for debugging."
        },
        "yandexMusic.deezerAiDataUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/alexeyfv/slopless/84b6547a67b187a352a0c6fe4d056f570c7a0b5c/data/v0.2.0.json.gz",
          "description": "Where the snapshot of Deezer's AI detections is downloaded from. Change it only for debugging."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "yandexMusic.openRemote",
          "when": "view == yandexMusic.player && isMac",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yandexMusic.openRemote",
          "when": "isMac"
        },
        {
          "command": "yandexMusic.installRemote",
          "when": "isMac"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js",
    "e2e": "npm run compile && node ./out/test/e2e.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "mocha": "^10.4.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.4.0"
  }
}
