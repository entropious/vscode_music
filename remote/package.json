{
  "name": "yandex-music-remote",
  "productName": "Yandex Music Remote",
  "version": "0.1.0",
  "description": "Fullscreen remote for the Yandex Music player service of the VS Code extension.",
  "private": true,
  "license": "MIT",
  "main": "out/main.js",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run build && electron .",
    "mock": "bun dev/mock-service.ts",
    "package": "bun run build && bun scripts/package.ts"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/bun": "1.3.1",
    "@types/node": "22.20.5",
    "electron": "38.8.6",
    "typescript": "5.9.3"
  }
}
